       CAST(CONVERT(CHAR(8), o.OrderDate, 112) AS INT) AS DateKey,
       o.CustomerID,
       oi.ProductID,
       oi.Quantity,
       oi.UnitPrice
FROM   dbo.OrderItems AS oi
JOIN   dbo.Orders     AS o ON o.OrderID = oi.OrderID
WHERE  o.OrderStatus = N'Completed';</property>
